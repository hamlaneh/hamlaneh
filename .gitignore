# Secrets & config — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.ppk
id_rsa*
id_ed25519*
.npmrc
.netrc
secrets/

# Runtime data (anchored — do not ignore source dirs that happen to share names)
/data/
/uploads/
deploy/data/
*.db
*.sqlite
*.sqlite3

# Go
server/bin/
*.exe
*.test
*.out
coverage.*

# Node / webapp
# Anchored on purpose: server/internal/webassets/dist/ is a COMMITTED
# placeholder, not build output. go:embed of a missing directory is a compile
# error, so it exists to keep `go build ./...` working without a webapp build;
# deploy/Dockerfile replaces it with the real bundle. Do not add a bare
# `dist/` rule — it would make the server fail to compile in a fresh clone.
node_modules/
webapp/dist/
webapp/build/
.vite/
*.tsbuildinfo
coverage/
test-results/
playwright-report/
blob-report/
.playwright/
# Generated per e2e run: the throwaway compose environment (a random database
# password and the bootstrap admin credentials) plus the state file the
# workers read. Never committed — see webapp/e2e/support/stack.ts.
webapp/e2e/.stack/

# Tauri / Rust
desktop/src-tauri/target/

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# Scratch
*.log
tmp/
scratch/

# Claude Code local state (launch.json is shared on purpose)
.claude/worktrees/
.claude/settings.local.json

# Brand exports: the SVG symbols are committed under webapp/public/brand/.
# The 4096px PNG renders and the kit zip are derived artefacts — regenerate
# them from the SVG rather than carrying ~20 MB in every clone forever.
/exports/
