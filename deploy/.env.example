# Hamlaneh deployment environment — EXAMPLE FILE.
#
# The real file is deploy/.env: generated by deploy/install.sh, chmod 600,
# and never committed (gitignored). Every value below is intentionally
# fake and non-functional.

# Public domain (or bare IP) this instance is served on.
# "localhost" and bare IPs get a certificate from Caddy's internal CA;
# real domains get automatic publicly trusted certificates (ACME).
HAMLANEH_DOMAIN=localhost

# The published web ports, for the one shape where 80/443 already belong to
# something else on the host. IP and localhost installs only — a domain's
# publicly trusted certificate is issued over 80/443 or not at all. When the
# HTTPS port is custom, HAMLANEH_DOMAIN must carry the same port
# (e.g. 203.0.113.5:8443): that one value is what makes Caddy listen there
# and the server accept the Origin browsers actually send. install.sh's
# port step writes all of this consistently; prefer re-running it to hand
# edits. Empty means the defaults, 80 and 443.
#HAMLANEH_HTTP_PORT=
#HAMLANEH_HTTPS_PORT=

# The admin dashboard's own port (ADR 015) — OFF by default.
#
# /admin is a client-side route, so restricting the PAGE protects nothing;
# the surfaces with power are /api/v1/admin/* and /scim/v2/*, and they used to
# answer on the same port as the chat app. These five variables move them to a
# port of their own on the SAME host — same certificate, same session, no new
# DNS record — so that a cloud firewall, which filters by port and never by
# path, can reach them separately. The port is a deployment boundary and never
# an authorization decision: reaching it is not being an admin.
#
# All five empty means the split is off and every admin route stays on the web
# port, which is what a --non-interactive install gets, and what a re-run of an
# install that predates this feature gets unless it is told otherwise.
# install.sh's admin step writes all five consistently; prefer re-running it to
# hand edits.
#
#   _ADDR         the server's second listener. Empty disables it. The port in
#                 it must match the one deploy/Caddyfile proxies to (:9090).
#   _PORT         the port the dashboard is published and reached on.
#   _BIND         which host interface publishes it. "127.0.0.1:" is this
#                 machine only (reach it with ssh -L); EMPTY is every
#                 interface, i.e. reachable from the internet. Deleting the
#                 line is not the same as emptying it: absent falls back to
#                 loopback, which is the closed default.
#   _MOVED_PATHS  the powered paths the app port then REFUSES, so the surface
#                 is gone from it rather than merely unlinked. It covers only
#                 what MOVES: sign-in, the instance document, the bundle and
#                 the current user are carried by BOTH ports, so the dashboard
#                 can load and an operator on the loopback answer can sign in
#                 through the tunnel without opening the chat port.
#   _PAGE_PATHS   the dashboard page, which the app port REDIRECTS to the admin
#                 origin instead of refusing. /admin renders nothing until the
#                 API answers, so 404ing it would protect nothing — and sending
#                 it on is what lets the app's Admin control stay a plain
#                 "/admin", with the admin port published in no document an
#                 anonymous visitor reads. On the loopback answer that redirect
#                 goes somewhere the public app cannot reach, which is what
#                 "this machine only" means; open the dashboard through the
#                 tunnel and it works normally.
#HAMLANEH_ADMIN_ADDR=:9090
#HAMLANEH_ADMIN_PORT=9443
#HAMLANEH_ADMIN_BIND=127.0.0.1:
#HAMLANEH_ADMIN_MOVED_PATHS=^/(api/v1/admin/|scim/v2/)
#HAMLANEH_ADMIN_PAGE_PATHS=^/admin(/|$)

# The host part of HAMLANEH_DOMAIN with no port — the certificate Caddy
# serves to a client that names no site, which is every client connecting
# by IP address (SNI exists for hostnames only). install.sh writes it; on a
# domain install it is inert.
HAMLANEH_DEFAULT_SNI=localhost

# Who issues the certificate: "internal" (Caddy's own CA) for an IP or
# localhost install — a public IP gets no certificate otherwise — and "acme"
# for a domain. install.sh writes it from the domain kind.
HAMLANEH_CERT_ISSUER=internal

# The hostname serving uploaded files (ADR 003). install.sh sets this to
# files.<your-domain> when you install with a real domain, and leaves it alone
# otherwise: "files." in front of a bare IP is a name no certificate authority
# can issue for and Caddy's internal CA will not cover, so gluing it together
# costs a month of failing ACME orders and buys nothing. Bare-IP and localhost
# installs serve files from the app origin, with the same headers.
HAMLANEH_FILES_DOMAIN=files.localhost

# Password for the bundled PostgreSQL service (user "hamlaneh").
# install.sh generates a random value (openssl rand -base64 32) into
# deploy/.env. This placeholder is not a working credential.
POSTGRES_PASSWORD=REPLACED_AT_INSTALL

# Signs the expiring URLs that uploaded files are served by (ADR 003).
#
# The files origin (files.${HAMLANEH_DOMAIN}) is cookie-less on purpose, so a
# request for a file carries no session: the signed URL IS the credential,
# and this key is what makes one unforgeable. install.sh generates a random
# value (openssl rand -base64 32) into deploy/.env; the server refuses to
# start without one, because a key it invented per boot would break every URL
# it had already handed out, and a built-in default would be no key at all.
#
# At least 32 bytes. Changing it invalidates every URL already minted —
# clients re-fetch the message and get fresh ones, so the cost is a reload,
# not lost data. This placeholder is not a working key.
HAMLANEH_FILE_URL_KEY=REPLACED_AT_INSTALL

# Keys the hash chain over the audit log.
#
# Every audit entry carries an HMAC over its own fields and the hash of the
# entry before it, so an edited or deleted row stops verifying. That makes
# the log tamper-EVIDENT, not tamper-proof: somebody with database access
# can still rewrite the whole chain — what they cannot do is rewrite it
# invisibly without this key, which is why it lives here and not in the
# database. install.sh generates a random value (openssl rand -base64 32);
# the server refuses to start without one.
#
# At least 32 bytes. Changing it makes every entry recorded under the old
# key fail verification — the rows are still there and still readable, but
# the instance can no longer vouch for them. This placeholder is not a
# working key.
HAMLANEH_AUDIT_KEY=REPLACED_AT_INSTALL

# Where uploaded file bytes are kept. Postgres holds only the metadata; the
# blobs are files named after the server-generated attachment UUID. Compose
# mounts a named volume here, so this is normally left exactly as it is.
HAMLANEH_DATA_DIR=/var/lib/hamlaneh

# First-admin bootstrap. The server reads these ONLY while the users table
# is empty (fresh install); afterwards they are ignored. install.sh
# generates the password and prints it once; the admin must change it at
# first sign-in. Empty values disable bootstrap entirely.
HAMLANEH_ADMIN_USERNAME=admin
HAMLANEH_ADMIN_PASSWORD=REPLACED_AT_INSTALL
HAMLANEH_ADMIN_LOCALE=en

# Absolute public origin of this instance, used to build the links that go
# out by email. The server cannot infer it — Caddy owns the origin and
# terminates TLS. Left empty it defaults to https://${HAMLANEH_DOMAIN}, which
# is right for almost every install; set it only when the public URL differs
# (a path prefix, or a domain Caddy does not know about). No query, no
# fragment.  e.g.  HAMLANEH_PUBLIC_URL=https://chat.example.invalid/hamlaneh
HAMLANEH_PUBLIC_URL=

# Password reset by email — OFF by default.
#
# Leaving HAMLANEH_SMTP_HOST empty disables password reset entirely: the
# endpoints stay reachable and answer exactly as they do for an address that
# does not exist, and the sign-in screen omits the "Forgot password?" link
# rather than offering one that goes nowhere.
#
# Setting the host turns reset on and makes HAMLANEH_SMTP_FROM required. The
# example forms below live in the comments and the values are left EMPTY on
# purpose: a pre-filled sender would satisfy that check, and an instance that
# starts up mailing from a domain nobody owns is worse than one that refuses
# to start. A half-configured transport stops the server with a message
# naming the missing variable, instead of failing at somebody's first
# forgotten password.
#
#   HAMLANEH_SMTP_HOST=smtp.example.invalid
#   HAMLANEH_SMTP_FROM=hamlaneh@chat.example.invalid
#   HAMLANEH_SMTP_FROM_NAME=Hamlaneh
HAMLANEH_SMTP_HOST=
HAMLANEH_SMTP_FROM=
HAMLANEH_SMTP_FROM_NAME=

# Connection protection: starttls (the default), tls (implicit TLS), or none.
# Empty means starttls. "none" exists only for a relay reachable across a
# private container network and must always be chosen deliberately.
HAMLANEH_SMTP_ENCRYPTION=

# Port. Empty means the conventional port for the encryption mode: 587 for
# starttls, 465 for tls, 25 for none.
HAMLANEH_SMTP_PORT=

# Submission credentials: set both or neither. Never put a real one in this
# file — it is committed. Real values go in deploy/.env, which is gitignored
# and chmod 600.
HAMLANEH_SMTP_USERNAME=
HAMLANEH_SMTP_PASSWORD=

# Single sign-on (OpenID Connect) — OFF by default.
#
# Leaving HAMLANEH_OIDC_ISSUER empty disables it entirely: the sign-in screen
# omits the button rather than offering a door that goes nowhere, exactly as
# it omits "Forgot password?" without a mail transport.
#
# Set the issuer, the client id and the client secret together. A partial set
# stops the server with a message naming what is missing, instead of failing
# at somebody's first sign-in — and because the redirect URI is built from
# HAMLANEH_PUBLIC_URL and never from a request header, a configured provider
# with no public URL stops the server too.
#
# The redirect URI to register with your provider is
#   ${HAMLANEH_PUBLIC_URL}/api/v1/auth/oidc/callback
# and it is the only one this server will ever use.
#
# The issuer must be the exact value your provider publishes as "issuer" in
# its discovery document — it is compared byte for byte, which is what stops a
# token minted for a different tenant from being accepted here. Discovery
# itself happens on first use and is retried, so a provider that is down
# delays sign-on rather than stopping the server from starting.
#
# Values are left EMPTY on purpose: a pre-filled client id would satisfy the
# startup check and send people to a provider that has never heard of this
# instance.
#
#   HAMLANEH_OIDC_ISSUER=https://id.example.invalid
#   HAMLANEH_OIDC_CLIENT_ID=hamlaneh
#   HAMLANEH_OIDC_PROVIDER_NAME=Example ID
HAMLANEH_OIDC_ISSUER=
HAMLANEH_OIDC_CLIENT_ID=

# Never put a real one in this file — it is committed. Real values go in
# deploy/.env, which is gitignored and chmod 600.
HAMLANEH_OIDC_CLIENT_SECRET=

# What the sign-in button calls your provider. Empty means a generic "SSO".
HAMLANEH_OIDC_PROVIDER_NAME=

# Calls and meetings (ADR 005) — the LiveKit credential pair.
#
# Unlike mail and SSO above, this is NOT optional and has no off switch: the
# media plane ships in the stack, and both halves must be present or compose
# refuses to start. install.sh generates them (openssl rand -hex 16 and -hex
# 32) into deploy/.env. Hex rather than base64 because compose hands them to
# LiveKit as a YAML "<key>: <secret>" line, where a stray colon or quote in a
# base64 value would be read as syntax.
#
# What the pair actually is: LiveKit trusts anything signed with the secret.
# Our server holds it and is the only thing that mints join tokens — scoped
# to one room, one identity, two minutes (ADR 005). LiveKit never learns who
# a user is. So this secret is exactly as sensitive as the session key: with
# it, anyone can mint themselves into any call on this instance.
#
# Changing the pair invalidates every unused join token and ends every call
# in progress; nothing is lost beyond that, because there is no call history
# to lose. These placeholders are not working credentials.
HAMLANEH_LIVEKIT_API_KEY=REPLACED_AT_INSTALL
HAMLANEH_LIVEKIT_API_SECRET=REPLACED_AT_INSTALL
